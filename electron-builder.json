{
  "appId": "com.alldown.app",
  "productName": "AllDown",
  "copyright": "Copyright © 2024 AllDown",
  "directories": {
    "output": "dist/electron"
  },
  "files": [
    "dist/main/**/*",
    "dist/renderer/**/*",
    "package.json",
    "assets/**/*"
  ],
  "extraResources": [
    {
      "from": "extension",
      "to": "extension",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "AllDown",
    "uninstallDisplayName": "AllDown"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "category": "public.app-category.utilities"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "category": "Network"
  },
  "publish": {
    "provider": "github",
    "owner": "patoloco22-spec",
    "repo": "alldown"
  }
}
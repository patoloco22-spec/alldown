{
  "appId": "com.alldown.app",
  "productName": "AllDown",
  "copyright": "Copyright © 2024 AllDown",
  "directories": {
    "output": "dist/electron",
    "buildResources": "assets"
  },
  "files": [
    "dist/main/**/*",
    "dist/renderer/**/*",
    "package.json",
    "assets/**/*"
  ],
  "extraResources": [
    {
      "from": "extension",
      "to": "extension",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "portable",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "assets/icon.ico",
    "publisherName": "AllDown",
    "verifyUpdateCodeSignature": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "AllDown",
    "uninstallDisplayName": "AllDown",
    "license": "assets/license.txt",
    "include": "assets/installer.nsh",
    "artifactName": "AllDown-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "AllDown-Portable-${version}.${ext}"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "assets/icon.icns",
    "category": "public.app-category.utilities",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "assets/entitlements.mac.plist",
    "entitlementsInherit": "assets/entitlements.mac.plist",
    "artifactName": "AllDown-${version}-${arch}.${ext}"
  },
  "dmg": {
    "title": "AllDown ${version}",
    "icon": "assets/dmg-icon.icns",
    "background": "assets/dmg-background.png",
    "window": {
      "width": 540,
      "height": 380
    },
    "contents": [
      {
        "x": 130,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      },
      {
        "x": 410,
        "y": 220,
        "type": "file"
      }
    ]
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "deb",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "rpm",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "assets/icon.png",
    "category": "Network",
    "maintainer": "AllDown Team <team@alldown.app>",
    "description": "Modern Cross-Platform Download Manager",
    "artifactName": "AllDown-${version}-${arch}.${ext}"
  },
  "appImage": {
    "runtimeFile": "libfuse2"
  },
  "deb": {
    "depends": [
      "libfuse2",
      "libnss3",
      "libatk1.0-0",
      "libatk-bridge2.0-0",
      "libcups2",
      "libdrm2",
      "libxkbcommon0",
      "libxcomposite1",
      "libxdamage1",
      "libxfixes3",
      "libxrandr2",
      "libgbm1",
      "libasound2"
    ]
  },
  "rpm": {
    "depends": [
      "fuse",
      "nss",
      "atk",
      "at-spi2-atk",
      "cups-libs",
      "libdrm",
      "libxkbcommon",
      "libxcomposite",
      "libxdamage",
      "libxfixes",
      "libxrandr",
      "mesa-libgbm",
      "alsa-lib"
    ]
  },
  "publish": {
    "provider": "github",
    "owner": "alldown",
    "repo": "alldown"
  },
  "releaseInfo": {
    "releaseNotesFile": "RELEASE_NOTES.md"
  }
}